{
  "manifest_version": 3,
  "name": "Google Meet External Bridge",
  "version": "1.1.0",
  "description": "Control y monitoreo bidireccional de Google Meet mediante daemon concentrador WebSocket local y LAN.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Meet External Bridge"
  }
}
